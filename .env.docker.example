# Local Docker defaults. Copy this file to .env before starting Compose.
# These values are for local development only and must not be reused in deployment.
APP_PORT=4200
MONGO_PORT=27017

MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=kamra_dev
AUTH_TOKEN_SECRET=replace-this-local-secret
CORS_ALLOWED_ORIGINS=http://localhost:4200

# The first app container start seeds the local catalog, admin, and demo household.
KAMRA_AUTO_SEED=1
SEED_ADMINUSER_USERNAME=admin@example.test
SEED_ADMINUSER_PASSWORD=local-admin-password
SEED_CATALOG_V1=1
SEED_DEMO_HOUSEHOLD_PASSWORD=local-demo-password
